{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "REGISTRY_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": false,
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    }
  }
}
