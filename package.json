{
  "name": "shadcn-ng",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "description": "CLI y registry estático para distribuir recursos Angular editables.",
  "author": "Adrián UB",
  "license": "MIT",
  "funding": "https://github.com/sponsors/adrian-ub",
  "homepage": "https://github.com/adrian-ub/shadcn-ng#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian-ub/shadcn-ng.git"
  },
  "bugs": "https://github.com/adrian-ub/shadcn-ng/issues",
  "keywords": [
    "angular",
    "cli",
    "components",
    "registry",
    "shadcn",
    "shadcn-ng",
    "tailwind"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./registry": "./dist/registry.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "shadcn-ng": "bin/shadcn-ng.mjs"
  },
  "files": [
    "LICENSE.md",
    "README.md",
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint .",
    "bench": "vitest bench --run --config benchmarks/vitest.config.ts",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:e2e": "vitest --run --config vitest.e2e.config.ts",
    "registry:build": "node --experimental-strip-types scripts/build-registry.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "commander": "catalog:",
    "diff": "catalog:",
    "fast-glob": "catalog:",
    "picocolors": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@antfu/ni": "catalog:",
    "@codspeed/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "pkg-pr-new": "catalog:",
    "pnpm": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
